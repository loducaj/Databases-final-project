# Copy this file to .env and fill in the two passwords. .env is in .gitignore.
MYSQL_HOST=localhost
MYSQL_PORT=3306
DB_NAME=jobtrail

# Admin login. Only database/setup.py uses it, to build the database and the app user.
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=change-me

# The app's own limited login: SELECT, INSERT, UPDATE and DELETE on jobtrail only.
# setup.py creates this MySQL user with whatever password you put here.
APP_DB_USER=jobtrail_app
APP_DB_PASSWORD=change-me
